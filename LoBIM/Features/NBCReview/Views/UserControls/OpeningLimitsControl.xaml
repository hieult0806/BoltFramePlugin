<UserControl x:Class="LoBIM.Features.NBCReview.Views.UserControls.OpeningLimitsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tables Content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
            <!-- Table 3.2.3.1.-D -->
            <GroupBox Header="Table 3.2.3.1.-D: Unprotected Opening Limits for a Building or Fire Compartment that is Sprinklered Throughout"
                      Padding="10" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Forming Part of Sentence 3.1.6.9.(5) and Article 3.2.3.1."
                               FontSize="11" FontStyle="Italic" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <TextBlock Text="Area of Unprotected Opening for Groups A, B, C, D and F, Division 3 Occupancies, %"
                               FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <DataGrid x:Name="TableD" AutoGenerateColumns="False" IsReadOnly="False"
                              GridLinesVisibility="All" HeadersVisibility="All"
                              FontSize="11" RowHeight="25" ColumnHeaderHeight="30"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell">
                                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5,3"/>
                            </Style>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Background" Value="#FFE8E8E8"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Max. Area, m²" Binding="{Binding MaxArea}" Width="100"/>
                            <DataGridTextColumn Header="0" Binding="{Binding D0}" Width="60"/>
                            <DataGridTextColumn Header="1.2" Binding="{Binding D1_2}" Width="60"/>
                            <DataGridTextColumn Header="1.5" Binding="{Binding D1_5}" Width="60"/>
                            <DataGridTextColumn Header="2.0" Binding="{Binding D2_0}" Width="60"/>
                            <DataGridTextColumn Header="2.5" Binding="{Binding D2_5}" Width="60"/>
                            <DataGridTextColumn Header="3" Binding="{Binding D3}" Width="60"/>
                            <DataGridTextColumn Header="4" Binding="{Binding D4}" Width="60"/>
                            <DataGridTextColumn Header="5" Binding="{Binding D5}" Width="60"/>
                            <DataGridTextColumn Header="6" Binding="{Binding D6}" Width="60"/>
                            <DataGridTextColumn Header="7" Binding="{Binding D7}" Width="60"/>
                            <DataGridTextColumn Header="8" Binding="{Binding D8}" Width="60"/>
                            <DataGridTextColumn Header="9" Binding="{Binding D9}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>

            <!-- Table 3.2.3.1.-E -->
            <GroupBox Header="Table 3.2.3.1.-E: Unprotected Opening Limits for a Building or Fire Compartment that is Sprinklered Throughout"
                      Padding="10" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Forming Part of Sentence 3.1.6.9.(5) and Article 3.2.3.1."
                               FontSize="11" FontStyle="Italic" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <TextBlock Text="Area of Unprotected Opening for Groups E and F, Division 1 and 2 Occupancies, %"
                               FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <DataGrid x:Name="TableE" AutoGenerateColumns="False" IsReadOnly="False"
                              GridLinesVisibility="All" HeadersVisibility="All"
                              FontSize="11" RowHeight="25" ColumnHeaderHeight="30"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell">
                                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5,3"/>
                            </Style>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Background" Value="#FFE8E8E8"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Max. Area, m²" Binding="{Binding MaxArea}" Width="100"/>
                            <DataGridTextColumn Header="0" Binding="{Binding E0}" Width="50"/>
                            <DataGridTextColumn Header="1.2" Binding="{Binding E1_2}" Width="50"/>
                            <DataGridTextColumn Header="1.5" Binding="{Binding E1_5}" Width="50"/>
                            <DataGridTextColumn Header="2.0" Binding="{Binding E2_0}" Width="50"/>
                            <DataGridTextColumn Header="2.5" Binding="{Binding E2_5}" Width="50"/>
                            <DataGridTextColumn Header="3" Binding="{Binding E3}" Width="50"/>
                            <DataGridTextColumn Header="4" Binding="{Binding E4}" Width="50"/>
                            <DataGridTextColumn Header="5" Binding="{Binding E5}" Width="50"/>
                            <DataGridTextColumn Header="6" Binding="{Binding E6}" Width="50"/>
                            <DataGridTextColumn Header="7" Binding="{Binding E7}" Width="50"/>
                            <DataGridTextColumn Header="8" Binding="{Binding E8}" Width="50"/>
                            <DataGridTextColumn Header="9" Binding="{Binding E9}" Width="50"/>
                            <DataGridTextColumn Header="10" Binding="{Binding E10}" Width="50"/>
                            <DataGridTextColumn Header="11" Binding="{Binding E11}" Width="50"/>
                            <DataGridTextColumn Header="12" Binding="{Binding E12}" Width="50"/>
                            <DataGridTextColumn Header="13" Binding="{Binding E13}" Width="50"/>
                            <DataGridTextColumn Header="14" Binding="{Binding E14}" Width="50"/>
                            <DataGridTextColumn Header="15" Binding="{Binding E15}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="1" Background="#FFF5F5F5" Padding="10" BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reset to Defaults" Click="ResetButton_Click"
                        Width="130" Height="32" Margin="0,0,10,0"
                        Background="#FFFF9800" Foreground="White"
                        ToolTip="Reset all table values to default values"/>
                <Button Content="Save Changes" Click="SaveButton_Click"
                        Width="120" Height="32"
                        Background="#FF16A085" Foreground="White"
                        ToolTip="Save the current table values to configuration"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
