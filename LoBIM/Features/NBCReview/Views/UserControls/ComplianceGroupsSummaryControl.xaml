<UserControl x:Class="LoBIM.Features.NBCReview.Views.UserControls.ComplianceGroupsSummaryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <GroupBox Header="Compliance Groups Summary (Double-click to highlight group)"
              Padding="5">
        <DataGrid ItemsSource="{Binding DistanceGroups}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF5F5F5"
                  HeadersVisibility="Column"
                  MouseDoubleClick="DataGrid_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Orientation"
                                    Binding="{Binding Orientation}"
                                    Width="100"/>
                <DataGridTextColumn Header="Distance Range"
                                    Binding="{Binding DistanceRange}"
                                    Width="150"/>
                <DataGridTextColumn Header="Wall Count"
                                    Binding="{Binding WallCount}"
                                    Width="100"/>
                <DataGridTextColumn Header="Total Gross Area"
                                    Binding="{Binding TotalGrossAreaFormatted}"
                                    Width="130"/>
                <DataGridTextColumn Header="Total Openings"
                                    Binding="{Binding TotalOpeningsAreaFormatted}"
                                    Width="130"/>
                <DataGridTextColumn Header="Avg Opening %"
                                    Binding="{Binding AverageOpeningPercentageFormatted}"
                                    Width="120"/>
                <DataGridTextColumn Header="Total Net Area"
                                    Binding="{Binding TotalNetAreaFormatted}"
                                    Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
    </GroupBox>
</UserControl>
