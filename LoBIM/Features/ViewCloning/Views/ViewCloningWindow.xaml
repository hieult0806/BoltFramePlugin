<Window x:Class="LoBIM.Features.ViewCloning.Views.ViewCloningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Clone Views from Linked Files"
        Height="600"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Clone Views from Linked Revit Files"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Linked Files -->
            <GroupBox Grid.Column="0"
                      Header="Linked Files"
                      Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Refresh Button -->
                    <Button Grid.Row="0"
                            Content="Refresh"
                            Command="{Binding RefreshLinkedFilesCommand}"
                            Margin="0,0,0,5"
                            Padding="5"
                            HorizontalAlignment="Stretch"/>

                    <!-- Linked Files List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding LinkedFiles}"
                             SelectedItem="{Binding SelectedLinkedFile}"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ViewCount, StringFormat='Views: {0}'}"
                                               FontSize="10"
                                               Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- Right Panel: Views -->
            <GroupBox Grid.Column="1"
                      Header="Views Available for Cloning"
                      Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Selection Buttons -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,5">
                        <Button Content="Select All"
                                Command="{Binding SelectAllViewsCommand}"
                                Padding="10,5"
                                Margin="0,0,5,0"/>
                        <Button Content="Deselect All"
                                Command="{Binding DeselectAllViewsCommand}"
                                Padding="10,5"/>
                    </StackPanel>

                    <!-- Configuration Options -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Name Prefix -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Name Prefix:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,5"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding NamePrefix, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="5"
                                 Margin="0,0,0,5"
                                 VerticalContentAlignment="Center"/>

                        <!-- Positioning Mode -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Positioning:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding PositioningModes}"
                                  SelectedItem="{Binding SelectedPositioningMode}"
                                  Padding="5"/>
                    </Grid>

                    <!-- Views DataGrid -->
                    <DataGrid Grid.Row="2"
                              x:Name="ViewsDataGrid"
                              ItemsSource="{Binding AvailableViews}"
                              SelectedItem="{Binding SelectedView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#FFF5F5F5"
                              HeadersVisibility="Column"
                              IsReadOnly="False"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="ViewsDataGrid_MouseDoubleClick"
                              PreviewMouseLeftButtonDown="ViewsDataGrid_PreviewMouseLeftButtonDown">

                        <DataGrid.Columns>
                            <!-- Selection Checkbox -->
                            <DataGridTemplateColumn Header="Clone" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- View Name -->
                            <DataGridTextColumn Header="View Name"
                                                Binding="{Binding ViewName}"
                                                Width="200"
                                                IsReadOnly="True"/>

                            <!-- View Type -->
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding ViewType}"
                                                Width="120"
                                                IsReadOnly="True"/>

                            <!-- Level -->
                            <DataGridTextColumn Header="Level"
                                                Binding="{Binding LevelName}"
                                                Width="100"
                                                IsReadOnly="True"/>

                            <!-- Scale -->
                            <DataGridTextColumn Header="Scale"
                                                Binding="{Binding Scale, StringFormat='1:{0}'}"
                                                Width="80"
                                                IsReadOnly="True"/>

                            <!-- Status -->
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding StatusText}"
                                                Width="80"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Green"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Source Tracking Info -->
                            <DataGridTextColumn Header="Source"
                                                Binding="{Binding SourceTrackingText}"
                                                Width="*"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Blue"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                        <Setter Property="ToolTip" Value="{Binding SourceTrackingText}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#FFF0F0F0"
                BorderBrush="#FFCCCCCC"
                BorderThickness="0,1,0,0"
                Padding="10,5"
                Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       FontStyle="Italic"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Show in Project Browser"
                    Command="{Binding ShowInProjectBrowserCommand}"
                    Padding="15,5"
                    Margin="0,0,5,0"
                    ToolTip="Highlight the selected cloned view in the Project Browser"/>
            <Button Content="Log Selected Section Position"
                    Command="{Binding LogSectionMarkerPositionCommand}"
                    Padding="15,5"
                    Margin="0,0,5,0"
                    ToolTip="Select a section marker in Revit and click this to log its position"/>
            <Button Content="Clone Selected Views"
                    Command="{Binding CloneSelectedViewsCommand}"
                    Padding="15,5"
                    Margin="0,0,5,0"
                    IsDefault="True"/>
            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    Padding="15,5"
                    IsCancel="True"/>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="4"
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="Processing..."
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="20"
                             Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
