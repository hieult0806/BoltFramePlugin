<UserControl x:Class="BoltFramePlugin.Features.LimitingDistance.Views.UserControls.BuildingCodeComplianceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="1200">
    <Grid>
        <GroupBox Header="Building Code Compliance Summary (NBC)"
                  Padding="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto">
                <DataGrid ItemsSource="{Binding BuildingCodeCompliance}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="All"
                          AlternatingRowBackground="#FFF5F5F5"
                          HeadersVisibility="Column"
                          RowHeight="25"
                          ColumnHeaderHeight="65"
                          MinWidth="1100">

                    <!-- Custom cell style for compliance status -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompliant}" Value="True">
                                    <Setter Property="Background" Value="#FFE8F5E9"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCompliant}" Value="False">
                                    <Setter Property="Background" Value="#FFFFEBEE"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Occupancy&#x0a;Classification"
                                            Binding="{Binding OccupancyClassification}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Elevation"
                                            Binding="{Binding Elevation}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Background" Value="#FFE8F5E9"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Area of&#x0a;Exposing&#x0a;Building&#x0a;Face(Sqm)"
                                            Binding="{Binding ExposingBuildingFaceAreaFormatted}"
                                            Width="85"/>
                        <DataGridTextColumn Header="Limiting&#x0a;Distance&#x0a;(m)"
                                            Binding="{Binding LimitingDistanceFormatted}"
                                            Width="75"/>
                        <DataGridTextColumn Header="Maximum Area of&#x0a;Unprotected Openings&#x0a;Permitted, % of Exposing&#x0a;Building Face Area"
                                            Binding="{Binding MaxUnprotectedOpeningsPercentFormatted}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Maximum Aggregated&#x0a;Area of Unprotected&#x0a;openings in Exterior&#x0a;wall-Proposed %"
                                            Binding="{Binding ProposedUnprotectedOpeningsPercentFormatted}"
                                            Width="120"/>
                        <DataGridTextColumn Header="FRR"
                                            Binding="{Binding FireResistanceRating}"
                                            Width="60"/>
                        <DataGridTextColumn Header="Type of&#x0a;Construction&#x0a;Required"
                                            Binding="{Binding ConstructionTypeRequired}"
                                            Width="130"/>
                        <DataGridTextColumn Header="Type of&#x0a;Cladding&#x0a;Required"
                                            Binding="{Binding CladdingTypeRequired}"
                                            Width="130"/>
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding ComplianceStatus}"
                                            Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
