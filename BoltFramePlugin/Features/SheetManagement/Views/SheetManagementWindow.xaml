<Window x:Class="BoltFramePlugin.Features.SheetManagement.Views.SheetManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sheet Management"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Modern button style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Item Style with enhanced drag animations -->
        <Style x:Key="SheetListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter TargetName="ItemBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="8" ShadowDepth="2" Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="BorderBrush" Value="#999999"/>
                                <Setter TargetName="ItemBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="6" ShadowDepth="1" Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- Enhanced effect when both selected and hovered -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#D1E7FA"/>
                                <Setter Property="BorderBrush" Value="#0066CC"/>
                                <Setter TargetName="ItemBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="3" Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Smooth transitions for all property changes -->
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="1.0" To="1.0"
                                           Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Sheet Management"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"
                   Foreground="#333333"/>

        <!-- Filter Section -->
        <GroupBox Grid.Row="1" Header="Filter Sheets" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Parameter Selection -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Filter by:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding AvailableParameters}"
                          SelectedItem="{Binding SelectedParameter}"
                          Margin="0,0,10,0"
                          VerticalContentAlignment="Center"
                          Padding="8,5"/>

                <!-- Filter Text -->
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="Search:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBox Grid.Row="0" Grid.Column="3"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,5"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"/>

                <!-- Filter Buttons -->
                <Button Grid.Row="0" Grid.Column="4"
                        Content="Clear Filter"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource ModernButton}"/>
                <Button Grid.Row="0" Grid.Column="5"
                        Content="Reload"
                        Command="{Binding LoadSheetsCommand}"
                        Style="{StaticResource ModernButton}"/>
            </Grid>
        </GroupBox>

        <!-- Sheet List -->
        <GroupBox Grid.Row="2" Header="Sheets (Drag to Reorder)" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sheet ListBox with Drop Indicator Overlay -->
                <Grid Grid.Column="0">
                    <ListBox x:Name="SheetListBox"
                             ItemsSource="{Binding FilteredSheets}"
                             ItemContainerStyle="{StaticResource SheetListBoxItem}"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="SheetListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="SheetListBox_PreviewMouseMove"
                             Drop="SheetListBox_Drop"
                             DragOver="SheetListBox_DragOver"
                             DragLeave="SheetListBox_DragLeave"
                             MouseDoubleClick="SheetListBox_MouseDoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Jump to Position..." Click="MenuItem_Jump_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="↕" FontSize="14" FontWeight="Bold"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Enhanced Drag Handle Icon -->
                                <Grid Grid.Column="0" x:Name="DragHandle">
                                    <Border Background="#F0F0F0"
                                            CornerRadius="3"
                                            Margin="2"
                                            Padding="4,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <!-- Three rows of dots for grip -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="2" Height="2" Fill="#999999" Margin="1,0"/>
                                                <Ellipse Width="2" Height="2" Fill="#999999" Margin="1,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="2" Height="2" Fill="#999999" Margin="1,1"/>
                                                <Ellipse Width="2" Height="2" Fill="#999999" Margin="1,1"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="2" Height="2" Fill="#999999" Margin="1,0"/>
                                                <Ellipse Width="2" Height="2" Fill="#999999" Margin="1,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Change Indicator -->
                                <Grid Grid.Column="1" x:Name="ChangeIndicator">
                                    <Border Background="#FFA500"
                                            CornerRadius="10"
                                            Width="16"
                                            Height="16"
                                            ToolTip="Position changed - needs renumbering"
                                            Visibility="{Binding HasChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="●"
                                                   FontSize="10"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <!-- Sheet Number with enhanced styling -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SheetNumber}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="8,0,5,0"
                                           Foreground="#0078D4"/>

                                <!-- Sheet Name -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding SheetName}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#333333"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <!-- Hover effect on drag handle -->
                                <Trigger SourceName="DragHandle" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DragHandle" Property="Cursor" Value="SizeAll"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                    <!-- Drop Indicator Line -->
                    <Canvas x:Name="DropIndicatorCanvas" IsHitTestVisible="False">
                        <Rectangle x:Name="DropIndicatorLine"
                                   Height="3"
                                   Fill="#0078D4"
                                   Visibility="Collapsed"
                                   Canvas.Left="10">
                            <Rectangle.Effect>
                                <DropShadowEffect Color="#0078D4" BlurRadius="8" Opacity="0.6" ShadowDepth="0"/>
                            </Rectangle.Effect>
                        </Rectangle>
                    </Canvas>
                </Grid>

                <!-- Up/Down Buttons -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button Content="▲"
                            Command="{Binding MoveSheetUpCommand}"
                            CommandParameter="{Binding ElementName=SheetListBox, Path=SelectedItem}"
                            Width="40"
                            Height="40"
                            Margin="0,0,0,5"
                            Style="{StaticResource ModernButton}"
                            ToolTip="Move Up"/>
                    <Button Content="▼"
                            Command="{Binding MoveSheetDownCommand}"
                            CommandParameter="{Binding ElementName=SheetListBox, Path=SelectedItem}"
                            Width="40"
                            Height="40"
                            Style="{StaticResource ModernButton}"
                            ToolTip="Move Down"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Renumbering Configuration -->
        <GroupBox Grid.Row="3" Header="Renumbering Configuration" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Prefix:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prefix}" Padding="5" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="2" Text="Start #:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="3" Text="{Binding StartNumber}" Padding="5" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="4" Text="Increment:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="5" Text="{Binding Increment}" Padding="5" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="6" Text="Padding:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="7" Text="{Binding PaddingDigits}" Padding="5"/>
            </Grid>
        </GroupBox>

        <!-- Action Buttons and Status -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Message -->
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       Foreground="#666666"/>

            <!-- Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Preview"
                        Command="{Binding PreviewRenumberingCommand}"
                        Style="{StaticResource ModernButton}"/>
                <Button Content="Renumber Sheets"
                        Command="{Binding RenumberSheetsCommand}"
                        Style="{StaticResource ModernButton}"/>
            </StackPanel>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="#88000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Processing..."
                           FontSize="20"
                           Foreground="White"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="20"
                             Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
