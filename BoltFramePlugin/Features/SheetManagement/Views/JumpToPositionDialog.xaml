<Window x:Class="BoltFramePlugin.Features.SheetManagement.Views.JumpToPositionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jump to Position"
        Height="550"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Move sheet to position:"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Selected Sheet Info -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Moving sheet:" FontSize="11" Foreground="#666666" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SelectedSheetNumber"
                               Text="A0.01"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#0078D4"
                               Margin="0,0,10,0"/>
                    <TextBlock x:Name="SelectedSheetName"
                               Text="Sheet Name"
                               FontSize="13"
                               Foreground="#333333"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Position Options -->
        <GroupBox Grid.Row="2" Header="Select Position" Padding="15">
            <StackPanel>
                <RadioButton x:Name="RadioFirst"
                             Content="Move to first position"
                             GroupName="Position"
                             IsChecked="True"
                             Style="{StaticResource RadioButtonStyle}"/>

                <RadioButton x:Name="RadioLast"
                             Content="Move to last position"
                             GroupName="Position"
                             Style="{StaticResource RadioButtonStyle}"/>

                <RadioButton x:Name="RadioBefore"
                             Content="Move before sheet:"
                             GroupName="Position"
                             Style="{StaticResource RadioButtonStyle}"/>

                <ComboBox x:Name="ComboBeforeSheet"
                          Margin="25,5,0,0"
                          Padding="8,5"
                          IsEnabled="{Binding IsChecked, ElementName=RadioBefore}"
                          DisplayMemberPath="SheetNumber"/>

                <RadioButton x:Name="RadioAfter"
                             Content="Move after sheet:"
                             GroupName="Position"
                             Style="{StaticResource RadioButtonStyle}"/>

                <ComboBox x:Name="ComboAfterSheet"
                          Margin="25,5,0,0"
                          Padding="8,5"
                          IsEnabled="{Binding IsChecked, ElementName=RadioAfter}"
                          DisplayMemberPath="SheetNumber"/>
            </StackPanel>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="OK"
                    IsDefault="True"
                    Click="OK_Click"
                    Style="{StaticResource DialogButton}"/>
            <Button Content="Cancel"
                    IsCancel="True"
                    Click="Cancel_Click"
                    Style="{StaticResource DialogButton}"/>
        </StackPanel>
    </Grid>
</Window>
