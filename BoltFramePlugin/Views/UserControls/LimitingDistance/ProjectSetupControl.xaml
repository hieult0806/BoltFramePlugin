<UserControl x:Class="BoltFramePlugin.Views.UserControls.LimitingDistance.ProjectSetupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Header -->
            <TextBlock Text="Project Initialization Setup"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Project Parameters Section -->
            <GroupBox Header="Project Parameters"
                      Padding="10"
                      Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Initialize required project parameters for Limiting Distance calculations:"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>

                    <DataGrid ItemsSource="{Binding RequiredProjectParameters}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#FFF5F5F5"
                              HeadersVisibility="Column"
                              Height="150"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter Name"
                                                Binding="{Binding Name}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding ParameterType}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Group"
                                                Binding="{Binding GroupName}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="Initialize Project Parameters"
                            Command="{Binding InitializeProjectParametersCommand}"
                            Height="35"
                            Width="220"
                            HorizontalAlignment="Left"
                            Background="#FF27AE60"
                            Foreground="White"
                            Margin="0,0,0,10"/>

                    <TextBlock Text="Note: This will create required project parameters if they don't exist."
                               FontStyle="Italic"
                               Foreground="Gray"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <!-- Custom Families Section -->
            <GroupBox Header="Custom Families"
                      Padding="10"
                      Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Load required custom families for Limiting Distance visualization:"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>

                    <DataGrid ItemsSource="{Binding RequiredFamilies}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#FFF5F5F5"
                              HeadersVisibility="Column"
                              Height="150"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Family Name"
                                                Binding="{Binding Name}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding Category}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Purpose"
                                                Binding="{Binding Purpose}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <Button Content="Load Required Families"
                                Command="{Binding LoadRequiredFamiliesCommand}"
                                Height="35"
                                Width="200"
                                Background="#FF3498DB"
                                Foreground="White"
                                Margin="0,0,10,0"/>
                        <Button Content="Browse Custom Family"
                                Command="{Binding BrowseCustomFamilyCommand}"
                                Height="35"
                                Width="180"
                                Background="#FF95A5A6"
                                Foreground="White"/>
                    </StackPanel>

                    <TextBlock Text="Note: Required families will be loaded from the plugin's resources folder."
                               FontStyle="Italic"
                               Foreground="Gray"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <!-- Filled Region Types Section -->
            <GroupBox Header="Filled Region Types"
                      Padding="10"
                      Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Initialize filled region types for distance group visualization:"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>

                    <DataGrid ItemsSource="{Binding RequiredFilledRegionTypes}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#FFF5F5F5"
                              HeadersVisibility="Column"
                              Height="120"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type Name"
                                                Binding="{Binding Name}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Pattern"
                                                Binding="{Binding PatternName}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Color"
                                                Binding="{Binding ColorDescription}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <Button Content="Initialize Filled Region Types"
                                Command="{Binding InitializeFilledRegionTypesCommand}"
                                Height="35"
                                Width="230"
                                Background="#FF9B59B6"
                                Foreground="White"
                                Margin="0,0,10,0"/>
                        <Button Content="Clean Up Duplicates"
                                Command="{Binding CleanupDuplicateFilledRegionTypesCommand}"
                                Height="35"
                                Width="180"
                                Background="#FFE74C3C"
                                Foreground="White"/>
                    </StackPanel>

                    <TextBlock Text="Note: This will create filled region types with specific patterns and colors for each distance group. Use 'Clean Up Duplicates' to remove old/duplicate types."
                               FontStyle="Italic"
                               Foreground="Gray"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <!-- Initialize All Section -->
            <GroupBox Header="Quick Setup"
                      Padding="10">
                <StackPanel>
                    <TextBlock Text="Initialize all required project components in one click:"
                               Margin="0,0,0,15"
                               TextWrapping="Wrap"/>

                    <Button Content="Initialize All Project Components"
                            Command="{Binding InitializeAllCommand}"
                            Height="40"
                            Width="280"
                            HorizontalAlignment="Left"
                            Background="#FFE74C3C"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            Margin="0,0,0,10"/>

                    <TextBlock Text="This will create all required project parameters, load families, and initialize filled region types."
                               FontStyle="Italic"
                               Foreground="Gray"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
