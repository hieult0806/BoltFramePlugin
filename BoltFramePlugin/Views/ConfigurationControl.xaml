<UserControl x:Class="BoltFramePlugin.Views.ConfigurationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Configuration" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Configure limiting distance calculation settings"
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Configuration Settings -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Building Classification Section -->
                <GroupBox Header="Building Classification" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Select the building classification for limiting distance calculations:"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding BuildingClassifications}"
                                  SelectedItem="{Binding BuildingClassification, Mode=TwoWay}"
                                  Width="250" HorizontalAlignment="Left"
                                  Padding="8,5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Ray Casting Configuration Section -->
                <GroupBox Header="Ray Casting Configuration" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Configure ray casting parameters for distance calculations:"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0" Text="Ray Length Limit:"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding RayLengthLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="5" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="meters"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock Text="Maximum distance for ray casting when detecting obstructions"
                                   FontSize="11" Foreground="Gray" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Arrow Creation Section -->
                <GroupBox Header="Arrow Creation" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <CheckBox Content="Automatically create arrows when detecting reference lines"
                                  IsChecked="{Binding AutoCreateArrows, Mode=TwoWay}"
                                  Margin="0,0,0,5"/>
                        <TextBlock Text="When enabled, both distance measurement arrows (rays) and wall orientation arrows will be automatically created after manual reference line detection. This does not affect automatic detection during property line selection."
                                   FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Additional Settings Section (for future use) -->
                <GroupBox Header="Additional Settings" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Additional configuration options will appear here."
                                   FontStyle="Italic" Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
