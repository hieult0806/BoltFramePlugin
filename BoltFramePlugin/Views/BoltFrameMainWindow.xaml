<Window x:Class="BoltFramePlugin.BoltFrameMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:resx="clr-namespace:BoltFramePlugin.Resources.Strings"
        xmlns:local="clr-namespace:BoltFramePlugin.Models"
        xmlns:vm="clr-namespace:BoltFramePlugin.ViewModels"
        mc:Ignorable="d"
        Title="{x:Static resx:Strings.AppTitle }" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="48"></RowDefinition>
        </Grid.RowDefinitions>
        <ToolBarTray Grid.Row="0" DockPanel.Dock="Top">
            <ToolBar>
                <Button Command="New" Content="New" />
                <Separator/>
                <Button Command="Open" Content="Open" />
                <Button Command="{Binding OpenConfigurationWindowCommand}" Content="Configuration" />
                <Separator/>
                <Button Command="{Binding CreateBeamPocketCommand}" Content="Beam Pockets" />
            </ToolBar>
        </ToolBarTray>
        <Grid Grid.Row="1" Width="Auto" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <ListView ItemsSource="{Binding Attributes}" x:Name="frameConfigurationListView" Grid.Column="0" BorderThickness="0,0,0,0" Margin="4,4,4,4" Background="#FFF3F3F3">
                <ListView.View>
                    <GridView>
                        <GridViewColumn x:Name="parameterCol" Header="Parameters" DisplayMemberBinding="{Binding Parameter}" Width="100"></GridViewColumn>
                        <GridViewColumn Header="Values" Width="Auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Style.Triggers>
                                                    <!-- Check if the parameter is "Stud Start" to display ComboBox -->
                                                    <DataTrigger Binding="{Binding Parameter}" Value="Stud Start">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <!-- ComboBox for Stud Start -->
                                                                    <ComboBox SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                                  ItemsSource="{Binding Source={x:Static local:StudStartEnumValues.Values}}"
                                                                  HorizontalAlignment="Stretch" />
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Parameter}" Value="Column Type">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <TextBox x:Name="ColumnTypeTextBox" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="Auto" HorizontalAlignment="Stretch">
                                                                        <TextBox.InputBindings>
                                                                            <MouseBinding Command="{Binding DataContext.ColumnTypeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                                      CommandParameter="{Binding ElementName=ColumnTypeTextBox}"
                                                                                      MouseAction="LeftClick"/>
                                                                        </TextBox.InputBindings>
                                                                    </TextBox>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>

                                                    <!-- StackPanel for Beam Type -->
                                                    <DataTrigger Binding="{Binding Parameter}" Value="Beam Type">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <TextBox x:Name="BeamTypeTextBox" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="Auto" HorizontalAlignment="Stretch">
                                                                        <TextBox.InputBindings>
                                                                            <MouseBinding Command="{Binding DataContext.BeamTypeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                                      CommandParameter="{Binding ElementName=BeamTypeTextBox}"
                                                                                      MouseAction="LeftClick"/>
                                                                        </TextBox.InputBindings>
                                                                    </TextBox>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>

                                                </Style.Triggers>
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <!-- TextBox for other fields -->
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                         HorizontalAlignment="Stretch" 
                                                         Width="150" 
                                                         MinWidth="0"/>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <DockPanel Grid.Column="1" Background="#FFF3F3F3" Margin="4,4,4,4">
                
            </DockPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center">
            <Button Width="100" Height="32" Content="Generate" FontSize="16" Margin="8 0 8 0" Command="{Binding GenerateFrameCommand}"/>
            <Button Width="100" Height="32" Content="Cancel" FontSize="16" Margin="8 0 8 0" Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>
