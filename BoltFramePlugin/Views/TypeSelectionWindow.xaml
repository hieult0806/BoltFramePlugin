<Window x:Class="BoltFramePlugin.TypeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BoltFramePlugin"
        xmlns:vm="clr-namespace:BoltFramePlugin.ViewModels"
        xmlns:helpers="clr-namespace:BoltFramePlugin.Helpers"
        xmlns:comps="clr-namespace:BoltFramePlugin.Views.Components"
        mc:Ignorable="d"
        Title="TypeSelectionWindow" Height="450" Width="800">
    <Grid>
        <ListBox ItemsSource="{Binding Elements}" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,0,0,64"
                 SelectedItem="{Binding SelectedItem }"
                 SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <comps:ElementPreview/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">            
            <Button Content="Confirm" Margin="8" Height="36" Width="128" VerticalAlignment="Bottom" Command="{Binding ConfirmCommand }"/>
            <Button Content="Cancel" Margin="8" Height="36" Width="128" VerticalAlignment="Bottom" Command="{Binding CancelCommand }"/>
        </StackPanel>
    </Grid>
</Window>
