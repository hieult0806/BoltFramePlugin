<Window x:Class="BoltFramePlugin.Views.LimitingDistanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Limiting Distance Calculator" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FFECECEC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="#FF2C3E50" Padding="15">
            <StackPanel>
                <TextBlock Text="Limiting Distance Calculator"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Select a property line and highlight perimeter walls"
                           FontSize="12"
                           Foreground="#FFBDC3C7"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content - Split Left/Right -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Section - Controls -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Building Classification -->
                    <GroupBox Header="Building Classification" Margin="0,0,0,10" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Classification:" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding BuildingClassifications}"
                                      SelectedItem="{Binding BuildingClassification}"
                                      Height="28"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Property Line Selection -->
                    <GroupBox Header="Property Line Selection" Margin="0,0,0,10" Padding="10">
                        <StackPanel>
                            <Button Content="Select Property Line"
                                    Command="{Binding SelectPropertyLineCommand}"
                                    Height="32"
                                    Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding PropertyLineInfo}"
                                       FontStyle="Italic"
                                       Foreground="#FF555555"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Reference Lines Detection -->
                    <GroupBox Header="Reference Lines" Margin="0,0,0,10" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Ray Length Limit (meters):" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding RayLengthLimit, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,10"/>
                            <Button Content="Detect Reference Lines"
                                    Command="{Binding DetectReferenceLinesCommand}"
                                    Height="32"
                                    Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding ReferenceLineCount}"
                                       FontStyle="Italic"
                                       Foreground="#FF555555"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Statistics Section -->
                    <GroupBox Header="Statistics" Margin="0,0,0,10" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding WallCount}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#FF2C3E50"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#FFBDC3C7"/>

            <!-- Right Section - Walls List -->
            <GroupBox Grid.Column="2" Header="Perimeter Walls (LD_IsPerimeter = True)" Padding="5">
                <DataGrid ItemsSource="{Binding PerimeterWalls}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#FFF5F5F5"
                          HeadersVisibility="Column"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">

                    <!-- Context Menu for right-click -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Highlight in 3D View"
                                      Command="{Binding HighlightWallIn3DCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Highlight in Floor Plan"
                                      Command="{Binding HighlightWallInFloorPlanCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Element ID"
                                            Binding="{Binding ElementId.Value}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Wall Name"
                                            Binding="{Binding Name}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Length"
                                            Binding="{Binding LengthFormatted}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Gross Area"
                                            Binding="{Binding GrossAreaFormatted}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Openings"
                                            Binding="{Binding OpeningsAreaFormatted}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Net Area"
                                            Binding="{Binding NetAreaFormatted}"
                                            Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- Footer Section -->
        <Border Grid.Row="2" Background="#FFE5E5E5" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Highlight in 3D View"
                        Command="{Binding HighlightWallsCommand}"
                        Width="150"
                        Height="32"
                        FontWeight="Bold"
                        Margin="0,0,10,0"/>
                <Button Content="Create Normal Arrows"
                        Command="{Binding CreateArrowsCommand}"
                        Width="160"
                        Height="32"
                        FontWeight="Bold"
                        Margin="0,0,10,0"/>
                <Button Content="Show Logs"
                        Command="{Binding ShowLogsCommand}"
                        Width="100"
                        Height="32"
                        FontWeight="Bold"
                        Margin="0,0,10,0"
                        Background="#FF3498DB"
                        Foreground="White"/>
                <Button Content="Close"
                        Command="{Binding CloseCommand}"
                        Width="90"
                        Height="32"
                        FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
