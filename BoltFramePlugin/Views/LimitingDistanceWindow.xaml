<Window x:Class="BoltFramePlugin.Views.LimitingDistanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:views="clr-namespace:BoltFramePlugin.Views"
        xmlns:ld="clr-namespace:BoltFramePlugin.Views.UserControls.LimitingDistance"
        mc:Ignorable="d"
        Title="Limiting Distance Calculator"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- Style for selected DataGrid row -->
        <Style x:Key="HighlightedRowStyle"
               TargetType="DataGridRow">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#FF4CAF50"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                    <Setter Property="FontWeight"
                            Value="Bold"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected"
                                   Value="True"/>
                        <Condition Property="IsMouseOver"
                                   Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background"
                            Value="#FF2196F3"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                    <Setter Property="FontWeight"
                            Value="Bold"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="#FFECECEC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0"
                Background="#FF2C3E50"
                Padding="15">
            <StackPanel>
                <TextBlock Text="Limiting Distance Calculator"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Select a property line and highlight perimeter walls"
                           FontSize="12"
                           Foreground="#FFBDC3C7"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tab Control for Main Content -->
        <TabControl Grid.Row="1"
                    Margin="10">
            <TabItem Header="Wall Analysis">
                <!-- Main Content - Split Left/Right -->
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Left Section - Controls -->
                    <ScrollViewer Grid.Column="0"
                                  Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Property Line Selection -->
                            <GroupBox Header="Property Line Selection"
                                      Margin="0,0,0,10"
                                      Padding="10">
                                <StackPanel>
                                    <Button Content="Select Property Line"
                                            Command="{Binding SelectPropertyLineCommand}"
                                            Height="32"
                                            Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding PropertyLineInfo}"
                                               FontStyle="Italic"
                                               Foreground="#FF555555"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Reference Lines Detection -->
                            <GroupBox Header="Reference Lines"
                                      Margin="0,0,0,10"
                                      Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding ReferenceLineCount}"
                                               FontStyle="Italic"
                                               Foreground="#FF555555"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Actions -->
                            <GroupBox Header="Actions"
                                      Margin="0,0,0,10"
                                      Padding="10">
                                <StackPanel>
                                    <Button Content="Highlight in 3D View"
                                            Command="{Binding HighlightWallsCommand}"
                                            Height="32"
                                            Background="#FF3498DB"
                                            Foreground="White"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Statistics Section -->
                            <GroupBox Header="Statistics"
                                      Margin="0,0,0,10"
                                      Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding WallCount}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#FF2C3E50"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1"
                                  Grid.Row="0"
                                  Width="5"
                                  HorizontalAlignment="Stretch"
                                  Background="#FFBDC3C7"/>

                    <!-- Right Section - Walls List -->
                    <ld:PerimeterWallsControl Grid.Column="2"
                                               Grid.Row="0"/>

                    <!-- Horizontal Splitter -->
                    <GridSplitter Grid.Row="1"
                                  Grid.ColumnSpan="3"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  Background="#FFBDC3C7"/>

                    <!-- Bottom Section - Distance Groups Summary -->
                    <GroupBox Grid.Row="2"
                              Grid.ColumnSpan="3"
                              Header="Distance Groups Summary (Double-click to highlight group)"
                              Padding="5">
                        <DataGrid ItemsSource="{Binding DistanceGroups}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#FFF5F5F5"
                                  HeadersVisibility="Column"
                                  MouseDoubleClick="DistanceGroupsDataGrid_MouseDoubleClick">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Orientation"
                                                    Binding="{Binding Orientation}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Distance Range"
                                                    Binding="{Binding DistanceRange}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="Wall Count"
                                                    Binding="{Binding WallCount}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Total Gross Area"
                                                    Binding="{Binding TotalGrossAreaFormatted}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="Total Openings"
                                                    Binding="{Binding TotalOpeningsAreaFormatted}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="Avg Opening %"
                                                    Binding="{Binding AverageOpeningPercentageFormatted}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="Total Net Area"
                                                    Binding="{Binding TotalNetAreaFormatted}"
                                                    Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                </Grid>
            </TabItem>

            <!-- Building Code Compliance Tab -->
            <TabItem Header="Code Compliance">
                <ld:BuildingCodeComplianceControl/>
            </TabItem>

            <!-- Configuration Tab -->
            <TabItem Header="Configuration">
                <ld:ConfigurationControl/>
            </TabItem>

            <!-- View Tracker Tab -->
            <TabItem Header="View Tracker">
                <ld:ViewTrackerControl/>
            </TabItem>

            <!-- Dev Tab -->
            <TabItem Header="Dev">
                <ld:DevTabControl/>
            </TabItem>
        </TabControl>

        <!-- Footer Section -->
        <Border Grid.Row="2"
                Background="#FFE5E5E5"
                Padding="15">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="Create Wall Projections"
                        Command="{Binding CreateWallProjectionsCommand}"
                        Width="180"
                        Height="32"
                        FontWeight="Bold"
                        Margin="0,0,10,0"
                        Background="#FF27AE60"
                        Foreground="White"/>
                <Button Content="Close"
                        Command="{Binding CloseCommand}"
                        Width="90"
                        Height="32"
                        FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
