<UserControl x:Class="BoltFramePlugin.Views.DevTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dev Tools Header -->
        <Border Grid.Row="0" Background="#FF34495E" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="Development Tools &amp; Testing"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Dev Tools Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <!-- Testing Section -->
                <GroupBox Header="Testing Tools" Margin="0,0,0,15" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Quick testing and debugging utilities"
                                   FontStyle="Italic"
                                   Foreground="#FF666666"
                                   Margin="0,0,0,10"/>

                        <Button Content="Check Ceiling-Wall Connections"
                                Command="{Binding CheckCeilingWallConnectionsCommand}"
                                Height="32"
                                Margin="0,0,0,10"
                                Background="#FF3498DB"
                                Foreground="White"/>

                        <Button Content="Check Wall-Ceiling Connections"
                                Command="{Binding CheckWallCeilingConnectionsCommand}"
                                Height="32"
                                Margin="0,0,0,10"
                                Background="#FF9B59B6"
                                Foreground="White"/>

                        <Button Content="Find Perimeter Walls Without Top Ceiling"
                                Command="{Binding FindPerimeterWallsWithoutTopCeilingCommand}"
                                Height="32"
                                Margin="0,0,0,10"
                                Background="#FFE74C3C"
                                Foreground="White"/>

                        <Button Content="Debug Wall-Ceiling Trimming"
                                Command="{Binding DebugWallCeilingTrimmingCommand}"
                                Height="32"
                                Background="#FFFF9800"
                                Foreground="White"/>
                    </StackPanel>
                </GroupBox>

                <!-- Debug Information -->
                <GroupBox Header="Debug Information" Margin="0,0,0,15" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Debug Output:"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding DebugOutput, Mode=OneWay}"
                                 Height="150"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 Background="#FFF5F5F5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Experimental Features -->
                <GroupBox Header="Experimental Features" Margin="0,0,0,15" Padding="10">
                    <StackPanel>
                        <CheckBox Content="Enable experimental feature 1"
                                  Margin="0,0,0,10"/>
                        <CheckBox Content="Enable experimental feature 2"
                                  Margin="0,0,0,10"/>
                        <CheckBox Content="Enable verbose logging"
                                  Margin="0,0,0,10"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
