<Window x:Class="BoltFramePlugin.Views.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BoltFramePlugin.Views"
        mc:Ignorable="d"
        Title="ConfigurationWindow" Height="450" Width="548">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="89*"/>
            <ColumnDefinition Width="185*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <Button Content="WorkingSpace"></Button>
            <Button Content="About"></Button>
        </StackPanel>
        <DockPanel Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="9*"></RowDefinition>
                    <RowDefinition Height="1*"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Grid.Row="0" Text="{Binding WorkingSpacePath}" Height="24"></TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" FlowDirection="RightToLeft">
                    <Button Width="100" Height="32" Content="Save"></Button>
                    <Button Width="100" Height="32" Content="Cancel"></Button>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
